generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  uid                     Int              @id @default(autoincrement())
  name                    String
  sku                     String           @unique
  basePrice               Decimal
  discountedPrice         Decimal?
  image                   String?
  description             String?
  uploaded                DateTime         @default(now())
  updated                 DateTime         @updatedAt
  discountPercentage      Int?
  categories              String[]
  sellerId                Int?
  soldCount               Int              @default(0)
  deletedAt               DateTime?
  deletedBy               Int?
  status                  ProductStatus    @default(PENDING)
  version                 Int              @default(0)
  isCodAllowed            Boolean          @default(true)
  materials               String?
  metaDescription         String?
  metaTitle               String?
  rejectionReason         String?
  tags                    String[]
  images                  String[]
  careInstructions        String?
  customOrderInstructions String?
  fulfillmentType         FulfillmentType  @default(READY_TO_SHIP)
  isCustomOrderAllowed    Boolean          @default(false)
  isLocalPickupAllowed    Boolean          @default(false)
  localPickupInstructions String?
  maxOrderQty             Int?
  minOrderQty             Int?
  processingTime          String?
  shippingFeeOverride     Decimal?
  videoUrl                String?
  bundleQuantity          Int?
  isBundle                Boolean          @default(false)
  cartItems               CartItem[]
  orderItems              OrderItem[]
  seller                  Seller?          @relation(fields: [sellerId], references: [uid])
  productOptions          ProductOption[]
  variants                ProductVariant[]
  wishlistItems           WishlistItem[]
}

model ProductVariant {
  uid                Int                  @id @default(autoincrement())
  productId          Int
  name               String
  sku                String               @unique
  stock              Int                  @default(0)
  price              Decimal?
  discountPercentage Int?
  discountedPrice    Decimal?
  soldCount          Int                  @default(0)
  images             String[]
  reservedStock      Int                  @default(0)
  isEnabled          Boolean              @default(true)
  cartItems          CartItem[]
  product            Product              @relation(fields: [productId], references: [uid], onDelete: Cascade)
  optionValues       ProductOptionValue[] @relation("ProductOptionValueToProductVariant")

  @@unique([productId, name])
}

model Customer {
  uid                   Int                   @id @default(autoincrement())
  name                  String
  email                 String?               @unique
  password              String?
  phone                 String?               @unique
  address               String?
  uploaded              DateTime              @default(now())
  updated               DateTime              @updatedAt
  passwordResetRequired Boolean               @default(false)
  role                  Role                  @default(USER)
  avatar                String?
  codCancellationCount  Int                   @default(0)
  deletedAt             DateTime?
  deletionRequestedAt   DateTime?
  deletionScheduledFor  DateTime?
  googleId              String?               @unique
  trustScore            Int                   @default(100)
  addresses             Address[]
  cart                  Cart?
  checkoutSessions      CheckoutSession[]
  notifications         Notification[]
  notificationSettings  NotificationSettings?
  orders                Order[]
  paymentMethods        PaymentMethod[]
  refreshTokens         RefreshToken[]
  sellerProfile         Seller?               @relation("CustomerSeller")
  wishlist              Wishlist?
}

model Cart {
  uid        Int        @id @default(autoincrement())
  customerId Int        @unique
  updated    DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [uid])
  items      CartItem[]
}

model CartItem {
  uid              Int             @id @default(autoincrement())
  cartId           Int
  productId        Int
  quantity         Int             @default(1)
  productVariantId Int?
  cart             Cart            @relation(fields: [cartId], references: [uid])
  product          Product         @relation(fields: [productId], references: [uid])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [uid])
}

model Order {
  uid                     Int             @id @default(autoincrement())
  customerId              Int
  products                String
  discount                Decimal?
  total                   Decimal
  uploaded                DateTime        @default(now())
  updated                 DateTime        @updatedAt
  idempotencyKey          String?         @unique
  status                  OrderStatus     @default(PENDING)
  courierName             String?
  sellerId                Int?
  shippedAt               DateTime?
  trackingNumber          String?
  autoConfirmAt           DateTime?
  cancellationReason      String?
  disputeStartedAt        DateTime?
  estimatedCompletionDate DateTime?
  estimatedDeliveryDate   DateTime?
  extensionCount          Int             @default(0)
  paymentMethod           String?
  paymentStatus           PaymentStatus   @default(PENDING)
  platformFee             Decimal         @default(0)
  proofPhotos             String?
  referenceNumber         String?         @unique
  rejectionReason         String?
  reminderStage           Int             @default(0)
  sellerEarnings          Decimal         @default(0)
  shippingAddressSnapshot String?
  shippingFee             Decimal         @default(0)
  shippingMethod          String?
  subtotal                Decimal         @default(0)
  customer                Customer        @relation(fields: [customerId], references: [uid])
  seller                  Seller?         @relation(fields: [sellerId], references: [uid])
  items                   OrderItem[]
  timeline                OrderTimeline[]
  payments                Payment[]
  shipments               OrderShipment[]
}

model CheckoutSession {
  uid            Int            @id @default(autoincrement())
  customerId     Int
  cartSnapshot   String
  lockedPrices   String
  totalAmount    Decimal
  status         CheckoutStatus @default(INITIATED)
  expiresAt      DateTime
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customer       Customer       @relation(fields: [customerId], references: [uid])
  payments       Payment[]
}

model Payment {
  uid               Int             @id @default(autoincrement())
  orderId           Int?
  checkoutSessionId Int
  amount            Decimal
  method            String
  status            PaymentStatus   @default(PENDING)
  gatewayRef        String?
  idempotencyKey    String          @unique
  errorMessage      String?
  attempts          Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [uid])
  order             Order?          @relation(fields: [orderId], references: [uid])
}

model ProductOption {
  uid       Int                  @id @default(autoincrement())
  productId Int
  name      String
  position  Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [uid], onDelete: Cascade)
  values    ProductOptionValue[]
}

model ProductOptionValue {
  uid      Int              @id @default(autoincrement())
  optionId Int
  value    String
  imageUrl String?
  option   ProductOption    @relation(fields: [optionId], references: [uid], onDelete: Cascade)
  variants ProductVariant[] @relation("ProductOptionValueToProductVariant")
}

model Seller {
  uid                 Int                 @id @default(autoincrement())
  name                String
  slug                String              @unique
  logo                String?
  banner              String?
  commissionRate      Decimal             @default(0.05)
  createdAt           DateTime            @default(now())
  deletedAt           DateTime?
  description         String?
  email               String              @unique
  phone               String?
  termsAccepted       Boolean             @default(false)
  termsAcceptedAt     DateTime?
  totalOrders         Int                 @default(0)
  totalSales          Decimal             @default(0)
  updatedAt           DateTime            @updatedAt
  customerId          Int                 @unique
  status              SellerStatus        @default(PENDING)
  approvedAt          DateTime?
  hasSeenWelcomeModal Boolean             @default(false)
  availableBalance    Decimal             @default(0)
  businessAddress     String?
  businessType        String?
  hasPriorExperience  Boolean             @default(false)
  idNumber            String?
  idType              String?
  isHandmade          Boolean             @default(false)
  legalName           String?
  location            String?
  pendingBalance      Decimal             @default(0)
  pinnedProductIds    Int[]
  portfolioLink       String?
  productCategories   String?
  rating              Decimal             @default(0)
  rejectionReason     String?
  socialMediaLink     String?
  totalWithdrawn      Decimal             @default(0)
  monthlyOrders       String?
  salesChannels       String[]
  sampleItems         String[]
  vehicleType         VehicleType?
  selfDeliveryEnabled Boolean             @default(false)
  freeShippingEnabled Boolean             @default(false)
  freeShippingThreshold Decimal?
  meetUpPoint         String?
  sellerCitymunCode   String?
  sellerProvCode      String?
  sellerRegCode       String?
  orders              Order[]
  orderItems          OrderItem[]
  products            Product[]
  customer            Customer            @relation("CustomerSeller", fields: [customerId], references: [uid], onDelete: Cascade)
  withdrawalRequests  WithdrawalRequest[]
  shipments           OrderShipment[]

  @@index([customerId, hasSeenWelcomeModal])
}

model OrderItem {
  uid              Int       @id @default(autoincrement())
  orderId          Int
  productId        Int
  sellerId         Int?
  quantity         Int
  price            Decimal
  status           String    @default("pending_payment")
  trackingNumber   String?
  shippingProvider String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  order            Order     @relation(fields: [orderId], references: [uid])
  product          Product   @relation(fields: [productId], references: [uid])
  seller           Seller?   @relation(fields: [sellerId], references: [uid])
}

model Address {
  uid           Int      @id @default(autoincrement())
  customerId    Int
  label         String?
  fullName      String
  phone         String
  streetAddress String
  aptSuite      String?
  city          String
  stateProvince String?
  postalCode    String
  country       String   @default("Philippines")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  barangay      String?
  province      String?
  region        String?
  landmark         String?
  zoneTierOverride Int?
  customer      Customer @relation(fields: [customerId], references: [uid], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isDefault])
}

model PaymentMethod {
  uid           Int               @id @default(autoincrement())
  customerId    Int
  type          PaymentMethodType
  accountName   String
  accountNumber String
  bankName      String?
  isDefault     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  customer      Customer          @relation(fields: [customerId], references: [uid], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isDefault])
}

model NotificationSettings {
  uid            Int      @id @default(autoincrement())
  customerId     Int      @unique
  orderUpdates   Boolean  @default(true)
  promotions     Boolean  @default(true)
  systemMessages Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [uid], onDelete: Cascade)
}

model Notification {
  uid        Int      @id @default(autoincrement())
  customerId Int
  title      String
  message    String
  type       String
  isRead     Boolean  @default(false)
  data       String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [uid], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isRead])
}

model Verification {
  uid       Int      @id @default(autoincrement())
  target    String
  code      String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([target, type])
}

model OrderTimeline {
  uid       Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  title     String
  message   String?
  photos    String[]
  createdBy Role?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [uid], onDelete: Cascade)

  @@index([orderId])
}

model WithdrawalRequest {
  uid       Int              @id @default(autoincrement())
  sellerId  Int
  amount    Decimal
  status    WithdrawalStatus @default(PENDING)
  method    String
  details   String?
  adminNote String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  seller    Seller           @relation(fields: [sellerId], references: [uid])

  @@index([sellerId])
  @@index([status])
}

model Wishlist {
  uid        Int            @id @default(autoincrement())
  customerId Int            @unique
  updated    DateTime       @updatedAt
  customer   Customer       @relation(fields: [customerId], references: [uid], onDelete: Cascade)
  items      WishlistItem[]
}

model WishlistItem {
  uid        Int      @id @default(autoincrement())
  wishlistId Int
  productId  Int
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [uid], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [uid], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model RefreshToken {
  uid          Int      @id @default(autoincrement())
  token        String   @unique
  userId       Int
  email        String?
  role         String
  sellerId     Int?
  sellerStatus String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model RateLimit {
  key       String   @id
  hits      Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model OrderShipment {
  uid              Int              @id @default(autoincrement())
  orderId          Int
  sellerId         Int
  fulfillmentType  ShipmentType     
  zoneTier         Int              
  shippingFee      Decimal          
  computedFuelCost Decimal          @default(0) 
  meetUpSnapshot   String?          
  status           ShipmentStatus   @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  order            Order            @relation(fields: [orderId], references: [uid], onDelete: Cascade)
  seller           Seller           @relation(fields: [sellerId], references: [uid], onDelete: Cascade)

  @@index([orderId])
  @@index([sellerId])
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy Int?     
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum CheckoutStatus {
  INITIATED
  VALIDATING
  AWAITING_PAYMENT
  PROCESSING_PAYMENT
  COMPLETED
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
  PARTIALLY_PAID
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
}

enum FulfillmentType {
  READY_TO_SHIP
  MADE_TO_ORDER
}

enum PaymentMethodType {
  GCASH
  PAYMAYA
  BANK
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum VehicleType {
  MOTORCYCLE
  TRICYCLE
  MULTICAB
  NONE
}

enum ShipmentType {
  PICKUP
  SELF_DELIVERY
  THIRD_PARTY
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELAYED_WEATHER
  COMPLETED
  FAILED
}
