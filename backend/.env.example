# ============================================================
# Knot & Bloom — Backend Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================


# ─── SERVER ─────────────────────────────────────────────────
# Port the Express server listens on (defaults to 3030)
PORT=3030

# Node environment: development | production | test
NODE_ENV=development


# ─── DATABASE ───────────────────────────────────────────────
# Prisma pooled connection URL (Transaction pooler, used at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"

# Direct database connection URL (Session pooler, used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"


# ─── SUPABASE ───────────────────────────────────────────────
# Project URL and Service Role Key (used for backend admin tasks)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ─── AUTHENTICATION / JWT ───────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-minimum-32-characters

# JWT access token expiry (e.g. 1h, 7d)
JWT_EXPIRES_IN=7d


# ─── GOOGLE OAUTH ───────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Full URL to your backend's OAuth callback endpoint
GOOGLE_CALLBACK_URL=http://localhost:3030/auth/google/callback


# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: http://localhost:8081,https://knotandbloomph.vercel.app
CORS_ORIGINS=http://localhost:8081,https://knotandbloomph.vercel.app


# ─── FRONTEND URL ───────────────────────────────────────────
# Used for OAuth redirect and other server-side redirects
FRONTEND_URL=http://localhost:8081


# ─── IMAGEKIT ───────────────────────────────────────────────
# From ImageKit dashboard → Developer Options
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
# Requires enabling ImageKit integration
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint


# ─── AI / ML SERVICES ───────────────────────────────────────
# Google Gemini API key — used by AiChatController
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key


# ─── EMAIL VERIFICATION (SMTP) ──────────────────────────────
# Mailtrap or Brevo SMTP credentials for sending auth emails
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@knotandbloom.ph


# ─── DIDIT KYC WEBHOOK ──────────────────────────────────────
# Webhook destination secret from Didit Business Console
DIDIT_WEBHOOK_SECRET=your_didit_webhook_secret
