generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  uid                   Int                   @id @default(autoincrement())
  name                  String
  email                 String                @unique
  password              String?
  phone                 String?               @unique
  address               String?
  avatar                String?
  role                  Role                  @default(USER)
  passwordResetRequired Boolean               @default(false)
  googleId              String?               @unique
  trustScore            Int                   @default(100)
  codCancellationCount  Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  deletionRequestedAt   DateTime?
  deletionScheduledFor  DateTime?
  addresses             Address[]
  cart                  Cart?
  checkoutSessions      CheckoutSession[]
  notifications         Notification[]
  notificationSettings  NotificationSettings?
  orders                Order[]
  paymentMethods        PaymentMethod[]
  refreshTokens         RefreshToken[]
  sellerProfile         Seller?
  wishlist              Wishlist?
  reviews               Review[]
}

model Seller {
  uid                   Int                 @id @default(autoincrement())
  name                  String
  slug                  String              @unique
  logo                  String?
  banner                String?
  email                 String              @unique
  phone                 String?
  status                SellerStatus        @default(PENDING)
  hasSeenWelcomeModal   Boolean             @default(false)
  userId                Int                 @unique
  approvedAt            DateTime?
  availableBalance      Decimal             @default(0)
  businessAddress       String?
  businessType          String?
  commissionRate        Decimal             @default(0.05)
  createdAt             DateTime            @default(now())
  description           String?
  freeShippingEnabled   Boolean             @default(false)
  freeShippingThreshold Decimal             @default(0)
  hasPriorExperience    Boolean             @default(false)
  idNumber              String?
  idType                String?
  isHandmade            Boolean             @default(false)
  legalName             String?
  meetUpPoint           String?
  monthlyOrders         String?
  pendingBalance        Decimal             @default(0)
  portfolioLink         String?
  productCategories     String[]            @default([])
  rating                Decimal?
  rejectionReason       String?
  salesChannels         String[]            @default([])
  sampleItems           String[]            @default([])
  selfDeliveryEnabled   Boolean             @default(false)
  sellerCitymunCode     String?
  sellerProvCode        String?
  sellerRegCode         String?
  socialMediaLink       String?
  termsAccepted         Boolean             @default(false)
  termsAcceptedAt       DateTime?
  totalOrders           Int                 @default(0)
  totalSales            Decimal             @default(0)
  totalWithdrawn        Decimal             @default(0)
  updatedAt             DateTime            @updatedAt
  vehicleType           VehicleType         @default(NONE)
  idPhotos              String[]            @default([])
  orders                Order[]
  orderItems            OrderItem[]
  shipments             OrderShipment[]
  products              Product[]
  user                  User                @relation(fields: [userId], references: [uid], onDelete: Cascade)
  withdrawalRequests    WithdrawalRequest[]
  reviews               Review[]

  @@index([userId, hasSeenWelcomeModal])
}

model Product {
  uid                     Int              @id @default(autoincrement())
  name                    String
  sku                     String           @unique
  basePrice               Decimal
  discountedPrice         Decimal?
  image                   String?
  description             String?
  uploaded                DateTime         @default(now())
  updated                 DateTime         @updatedAt
  discountPercentage      Int?
  categories              String[]
  sellerId                Int?
  soldCount               Int              @default(0)
  deletedAt               DateTime?
  deletedBy               Int?
  status                  ProductStatus    @default(PENDING)
  version                 Int              @default(0)
  isCodAllowed            Boolean          @default(true)
  materials               String?
  metaDescription         String?
  metaTitle               String?
  rejectionReason         String?
  tags                    String[]
  bundleQuantity          Int?
  careInstructions        String?
  customOrderInstructions String?
  fulfillmentType         FulfillmentType  @default(READY_TO_SHIP)
  images                  String[]
  isBundle                Boolean          @default(false)
  isCustomOrderAllowed    Boolean          @default(false)
  isLocalPickupAllowed    Boolean          @default(false)
  localPickupInstructions String?
  maxOrderQty             Int?
  minOrderQty             Int?
  processingTime          String?
  shippingFeeOverride     Decimal?
  videoUrl                String?
  cartItems               CartItem[]
  orderItems              OrderItem[]
  seller                  Seller?          @relation(fields: [sellerId], references: [uid])
  productOptions          ProductOption[]
  variants                ProductVariant[]
  wishlistItems           WishlistItem[]
  reviews                 Review[]
}

model ProductVariant {
  uid                Int                  @id @default(autoincrement())
  productId          Int
  name               String
  sku                String               @unique
  stock              Int                  @default(0)
  price              Decimal?
  discountPercentage Int?
  discountedPrice    Decimal?
  soldCount          Int                  @default(0)
  images             String[]
  isEnabled          Boolean              @default(true)
  reservedStock      Int                  @default(0)
  cartItems          CartItem[]
  product            Product              @relation(fields: [productId], references: [uid], onDelete: Cascade)
  optionValues       ProductOptionValue[] @relation("ProductOptionValueToProductVariant")

  @@unique([productId, name])
}

model Cart {
  uid     Int        @id @default(autoincrement())
  updated DateTime   @updatedAt
  userId  Int        @unique
  user    User       @relation(fields: [userId], references: [uid])
  items   CartItem[]
}

model CartItem {
  uid              Int             @id @default(autoincrement())
  cartId           Int
  productId        Int
  quantity         Int             @default(1)
  productVariantId Int?
  cart             Cart            @relation(fields: [cartId], references: [uid])
  product          Product         @relation(fields: [productId], references: [uid])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [uid])
}

model Order {
  uid                     Int             @id @default(autoincrement())
  products                String
  discount                Decimal?
  total                   Decimal
  uploaded                DateTime        @default(now())
  updated                 DateTime        @updatedAt
  idempotencyKey          String?         @unique
  status                  OrderStatus     @default(PENDING)
  courierName             String?
  sellerId                Int?
  shippedAt               DateTime?
  trackingNumber          String?
  autoConfirmAt           DateTime?
  cancellationReason      String?
  disputeStartedAt        DateTime?
  estimatedCompletionDate DateTime?
  estimatedDeliveryDate   DateTime?
  extensionCount          Int             @default(0)
  paymentMethod           String?
  paymentStatus           PaymentStatus   @default(PENDING)
  platformFee             Decimal         @default(0)
  proofPhotos             String?
  referenceNumber         String?         @unique
  rejectionReason         String?
  reminderStage           Int             @default(0)
  sellerEarnings          Decimal         @default(0)
  shippingAddressSnapshot String?
  shippingFee             Decimal         @default(0)
  shippingMethod          String?
  subtotal                Decimal         @default(0)
  userId                  Int
  progressImages          String[]
  progressImagesRequested Boolean         @default(false)
  seller                  Seller?         @relation(fields: [sellerId], references: [uid])
  user                    User            @relation(fields: [userId], references: [uid])
  items                   OrderItem[]
  shipments               OrderShipment[]
  timeline                OrderTimeline[]
  payments                Payment[]
}

model CheckoutSession {
  uid            Int            @id @default(autoincrement())
  cartSnapshot   String
  lockedPrices   String
  totalAmount    Decimal
  status         CheckoutStatus @default(INITIATED)
  expiresAt      DateTime
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userId         Int
  user           User           @relation(fields: [userId], references: [uid])
  payments       Payment[]
}

model Payment {
  uid               Int             @id @default(autoincrement())
  orderId           Int?
  checkoutSessionId Int
  amount            Decimal
  method            String
  status            PaymentStatus   @default(PENDING)
  gatewayRef        String?
  idempotencyKey    String          @unique
  errorMessage      String?
  attempts          Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [uid])
  order             Order?          @relation(fields: [orderId], references: [uid])
}

model ProductOption {
  uid       Int                  @id @default(autoincrement())
  productId Int
  name      String
  position  Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [uid], onDelete: Cascade)
  values    ProductOptionValue[]
}

model ProductOptionValue {
  uid      Int              @id @default(autoincrement())
  optionId Int
  value    String
  imageUrl String?
  option   ProductOption    @relation(fields: [optionId], references: [uid], onDelete: Cascade)
  variants ProductVariant[] @relation("ProductOptionValueToProductVariant")
}

model OrderItem {
  uid              Int       @id @default(autoincrement())
  orderId          Int
  productId        Int
  sellerId         Int?
  quantity         Int
  price            Decimal
  status           String    @default("pending_payment")
  trackingNumber   String?
  shippingProvider String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  order            Order     @relation(fields: [orderId], references: [uid])
  product          Product   @relation(fields: [productId], references: [uid])
  seller           Seller?   @relation(fields: [sellerId], references: [uid])
  review           Review?
}

model Review {
  uid         Int       @id @default(autoincrement())
  rating      Int       @default(5)
  title       String?
  content     String?
  photos      String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  userId      Int
  productId   Int
  sellerId    Int
  orderItemId Int?      @unique

  user        User      @relation(fields: [userId], references: [uid])
  product     Product   @relation(fields: [productId], references: [uid])
  seller      Seller    @relation(fields: [sellerId], references: [uid])
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [uid])

  @@index([productId])
  @@index([sellerId])
}

model Address {
  uid              Int      @id @default(autoincrement())
  label            String?
  fullName         String
  phone            String
  streetAddress    String
  aptSuite         String?
  city             String
  stateProvince    String?
  postalCode       String
  country          String   @default("Philippines")
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  barangay         String?
  province         String?
  region           String?
  landmark         String?
  userId           Int
  zoneTierOverride Int?
  user             User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model PaymentMethod {
  uid           Int               @id @default(autoincrement())
  type          PaymentMethodType
  accountName   String
  accountNumber String
  bankName      String?
  isDefault     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userId        Int
  user          User              @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model NotificationSettings {
  uid            Int      @id @default(autoincrement())
  orderUpdates   Boolean  @default(true)
  promotions     Boolean  @default(true)
  systemMessages Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
}

model Notification {
  uid       Int      @id @default(autoincrement())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

model Verification {
  uid       Int      @id @default(autoincrement())
  target    String
  code      String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([target, type])
}

model OrderTimeline {
  uid       Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  title     String
  message   String?
  photos    String[]
  createdBy Role?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [uid], onDelete: Cascade)

  @@index([orderId])
}

model WithdrawalRequest {
  uid       Int              @id @default(autoincrement())
  sellerId  Int
  amount    Decimal
  status    WithdrawalStatus @default(PENDING)
  method    String
  details   String?
  adminNote String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  seller    Seller           @relation(fields: [sellerId], references: [uid])

  @@index([sellerId])
  @@index([status])
}

model Wishlist {
  uid     Int            @id @default(autoincrement())
  updated DateTime       @updatedAt
  userId  Int            @unique
  user    User           @relation(fields: [userId], references: [uid], onDelete: Cascade)
  items   WishlistItem[]
}

model WishlistItem {
  uid        Int      @id @default(autoincrement())
  wishlistId Int
  productId  Int
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [uid], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [uid], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model RefreshToken {
  uid          Int      @id @default(autoincrement())
  token        String   @unique
  userId       Int
  email        String?
  role         String
  sellerId     Int?
  sellerStatus String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model RateLimit {
  key       String   @id
  hits      Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model OrderShipment {
  uid              Int            @id @default(autoincrement())
  orderId          Int
  sellerId         Int
  fulfillmentType  ShipmentType
  zoneTier         Int
  shippingFee      Decimal
  computedFuelCost Decimal        @default(0)
  meetUpSnapshot   String?
  status           ShipmentStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  order            Order          @relation(fields: [orderId], references: [uid], onDelete: Cascade)
  seller           Seller         @relation(fields: [sellerId], references: [uid], onDelete: Cascade)

  @@index([orderId])
  @@index([sellerId])
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy Int?
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum CheckoutStatus {
  INITIATED
  VALIDATING
  AWAITING_PAYMENT
  PROCESSING_PAYMENT
  COMPLETED
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
  PARTIALLY_PAID
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
}

enum FulfillmentType {
  READY_TO_SHIP
  MADE_TO_ORDER
}

enum PaymentMethodType {
  GCASH
  PAYMAYA
  BANK
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum VehicleType {
  MOTORCYCLE
  TRICYCLE
  MULTICAB
  NONE
}

enum ShipmentType {
  PICKUP
  SELF_DELIVERY
  THIRD_PARTY
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELAYED_WEATHER
  COMPLETED
  FAILED
}

model CustomTag {
  uid       Int      @id @default(autoincrement())
  name      String   @unique
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomCategory {
  uid       Int      @id @default(autoincrement())
  name      String   @unique
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
