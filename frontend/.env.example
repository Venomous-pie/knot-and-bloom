# ============================================================
# Knot & Bloom — Frontend (Expo) Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# IMPORTANT: All variables must be prefixed with EXPO_PUBLIC_
# to be accessible in the Expo/React Native bundle.
# ============================================================


# ─── API ─────────────────────────────────────────────────────
# Base URL of your backend API (no trailing slash, no /api suffix)
# Examples:
#   Local:      http://localhost:3030
#   Production: https://your-backend.railway.app
EXPO_PUBLIC_API_URL=http://localhost:3030


# ─── IMAGEKIT ────────────────────────────────────────────────
# From ImageKit dashboard → Developer Options
# URL Endpoint — e.g. https://ik.imagekit.io/your_imagekit_id
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Public API key (safe to expose in the client bundle)
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key


# ─── SUPABASE ────────────────────────────────────────────────
# Project URL and Anon Key (safe to expose in the client bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key


# ─── SMS VERIFICATION ───────────────────────────────────────
# Set to 'true' to enable the phone number option in the signup/login UI
EXPO_PUBLIC_ENABLE_SMS_OTP=false
